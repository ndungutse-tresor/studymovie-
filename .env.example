# ---------------------------------------------------------------------------
# StudyReel server configuration
# Copy to .env and adjust. Everything here has a working development default
# except the JWT secrets, which are mandatory in production.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Comma-separated origins allowed to call the API from a browser.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection string. Neon Free currently allows up to 100 projects
# per organization. Copy the pooled connection string from the Neon console;
# URL-encode any special characters in the password.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
# Connections held per instance. Keep at 1 on serverless.
DATABASE_POOL_MAX=10
# Set to false only for a local Postgres without TLS.
DATABASE_SSL=true

# Where generated development secrets are cached.
DATA_DIR=./data

# --- Authentication --------------------------------------------------------
# Required in production, minimum 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=1209600
BCRYPT_ROUNDS=12

# --- Progression gates -----------------------------------------------------
# Seconds a learner must spend on a chapter before its exam opens.
MIN_STUDY_SECONDS=120
# How long an exam attempt stays open before it is auto-submitted.
EXAM_WINDOW_SECONDS=1200
# Cool-down applied after this many consecutive failed attempts.
MAX_ATTEMPTS_BEFORE_COOLDOWN=2
RETRY_COOLDOWN_SECONDS=300

# --- Movie sources ---------------------------------------------------------
# The Internet Archive provider needs no key. TMDB is optional and adds
# ranking and artwork; get a key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
MOVIE_CACHE_TTL_MINUTES=180
MOVIE_REQUEST_TIMEOUT_MS=12000

# --- Movie object storage --------------------------------------------------
# Leave bucket, credentials, and public URL empty for local disk uploads.
# For Cloudflare R2, set region=auto, the account S3 endpoint, an R2 access key,
# the bucket name, and the bucket's public custom-domain URL.
MOVIE_STORAGE_BUCKET=
MOVIE_STORAGE_REGION=us-east-1
MOVIE_STORAGE_ENDPOINT=
MOVIE_STORAGE_ACCESS_KEY_ID=
MOVIE_STORAGE_SECRET_ACCESS_KEY=
MOVIE_STORAGE_PUBLIC_URL=
# Defaults to true when an endpoint is set; AWS S3 normally uses false.
MOVIE_STORAGE_FORCE_PATH_STYLE=
MOVIE_UPLOAD_MAX_MB=4096

# --- Seeded administrator --------------------------------------------------
# Created on first run. Change the password before any real deployment.
ADMIN_EMAIL=admin@studyreel.io
ADMIN_PASSWORD=ChangeMe!2024
